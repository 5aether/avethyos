# Here we set a bunch of parameters for your image build

# output image name, usually same as repo name, change as needed
IMAGE_NAME=avethyos

# Make this the same as your github username/organisation
REPO_ORGANIZATION="5aether"

IMAGE_DESC="AvethyOS with Hyprland and Quickshell"
IMAGE_KEYWORDS="bootc,oci,linux"

# Put your own image here for a fancy profile on https://artifacthub.io/!
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"

# Resolve this tag to a digest before building either Fedora stage.
BASE_IMAGE="quay.io/fedora/fedora-bootc:44"

# Official OGC Fedora kernel artifact; use an immutable digest to pin a release.
OGC_KERNEL_REF="ghcr.io/opengamingcollective/kernel-packages-fedora:latest-fc44"
