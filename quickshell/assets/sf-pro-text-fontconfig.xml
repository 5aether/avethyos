<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<fontconfig>
    <!-- Keep the system configuration, then prefer SF Pro Text for all
         regular UI text that Qt requests through the sans-serif family. -->
    <include ignore_missing="yes">/etc/fonts/fonts.conf</include>
    <alias>
        <family>SF Pro Text</family>
        <accept>
            <family>Noto Sans</family>
        </accept>
    </alias>
    <alias binding="strong">
        <family>sans-serif</family>
        <prefer>
            <family>SF Pro Text</family>
        </prefer>
    </alias>
    <alias binding="strong">
        <family>sans</family>
        <prefer>
            <family>SF Pro Text</family>
        </prefer>
    </alias>
</fontconfig>
