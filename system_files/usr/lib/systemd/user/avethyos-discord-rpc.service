[Unit]
Description=Share Discord RPC between native and Flatpak applications
After=systemd-tmpfiles-setup.service

[Service]
ExecStart=/usr/libexec/avethyos-discord-rpc
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=default.target
