[Unit]
Description=Initialize and migrate user desktop preferences
Before=default.target graphical-session-pre.target
ConditionPathIsDirectory=%h
ConditionUser=!sddm

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/libexec/avethyos-user-config
RemainAfterExit=yes

[Install]
WantedBy=default.target
