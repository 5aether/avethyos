#!/usr/bin/python3
"""Expose existing Discord RPC servers without interpreting their byte stream.

Flatpak shares the stable proxy directory, not individual socket inodes. Its
per-app runtime directories can then use links even when Discord starts later.
Native clients keep their own sockets; only missing standard paths are linked.
"""

import asyncio
import fcntl
import os
from pathlib import Path
import signal
import socket
import stat
import struct


SLOTS = range(10)
# Only for removing stale links generated by earlier AvethyOS images.
LEGACY_CLIENTS = (
    "org.equicord.equibop", "dev.vencord.Vesktop", "com.discordapp.Discord",
    "com.discordapp.DiscordCanary", "com.discordapp.DiscordPTB",
    "io.github.spacingbat3.webcord",
)


def listening_sockets():
    """Ask Linux for listener filesystem identities, including sandbox binds.

    /proc/net/unix contains the path used *inside* the sandbox, which differs
    from its host path. UNIX_DIAG_VFS identifies the actual device and inode.
    This also rejects stale files without opening probe sessions in Discord.
    See include/uapi/linux/unix_diag.h and net/unix/diag.c in the Linux sources.
    """
    listeners = set()
    # NETLINK_SOCK_DIAG=4; SOCK_DIAG_BY_FAMILY=20; TCP_LISTEN=10;
    # NLM_F_REQUEST|NLM_F_DUMP=0x301; UDIAG_SHOW_VFS=2.
    request = struct.pack("=BBHIIIII", socket.AF_UNIX, 0, 0, 1 << 10, 0, 2,
                          0xffffffff, 0xffffffff)
    with socket.socket(socket.AF_NETLINK, socket.SOCK_RAW, 4) as diagnostics:
        diagnostics.settimeout(1)
        diagnostics.send(struct.pack("=IHHII", 16 + len(request), 20, 0x301, 1, 0) + request)
        while True:
            data = diagnostics.recv(65536)
            offset = 0
            while offset < len(data):
                length, kind, _, _, _ = struct.unpack_from("=IHHII", data, offset)
                if kind == 3:  # NLMSG_DONE
                    return listeners
                if kind == 2:  # NLMSG_ERROR
                    error = -struct.unpack_from("=i", data, offset + 16)[0]
                    raise OSError(error, os.strerror(error))
                if data[offset + 17] == socket.SOCK_STREAM:
                    attribute = offset + 32  # header + unix_diag_msg
                    while attribute < offset + length:
                        size, tag = struct.unpack_from("=HH", data, attribute)
                        if tag == 1:  # UNIX_DIAG_VFS
                            inode, device = struct.unpack_from("=II", data, attribute + 4)
                            listeners.add((device, inode))
                        attribute += (size + 3) & ~3
                offset += (length + 3) & ~3


def real_socket(path, listeners):
    try:
        info = path.lstat()
        # unix/diag.c exports raw s_dev, not new_encode_dev(st_dev).
        # linux/kdev_t.h: MKDEV(major, minor) = major << 20 | minor.
        device = (os.major(info.st_dev) << 20) | os.minor(info.st_dev)
        return stat.S_ISSOCK(info.st_mode) and (device, info.st_ino & 0xffffffff) in listeners
    except OSError:
        return False


def link_target(slot):
    return f"discord-rpc/discord-ipc-{slot}"


def owns_link(path, slot):
    try:
        return os.readlink(path) == link_target(slot)
    except OSError:
        return False


class Bridge:
    def __init__(self, runtime):
        self.runtime = Path(runtime).absolute()
        self.directory = self.runtime / "discord-rpc"
        self.targets = {}
        self.servers = {}
        self.connections = set()
        self.lock = None

    def private_runtimes(self):
        return sorted(path for path in self.runtime.glob(".flatpak/*/xdg-run")
                      if path.is_dir() and not path.is_symlink())

    async def refresh(self):
        listeners = listening_sockets()
        for slot in SLOTS:
            canonical = self.runtime / f"discord-ipc-{slot}"
            try:
                target = os.readlink(canonical)
            except OSError:
                continue
            if (target in {f".flatpak/{client}/xdg-run/discord-ipc-{slot}"
                           for client in LEGACY_CLIENTS}
                    and not real_socket(self.runtime / target, listeners)):
                canonical.unlink(missing_ok=True)
        native = {slot: self.runtime / f"discord-ipc-{slot}" for slot in SLOTS
                  if real_socket(self.runtime / f"discord-ipc-{slot}", listeners)}
        private = self.private_runtimes()
        providers = sorted({path for directory in [*private, *self.runtime.glob("app/*")]
                            for slot in SLOTS
                            if real_socket(path := directory / f"discord-ipc-{slot}", listeners)})

        # Preserve each provider's assigned slot through normal scans/restarts.
        # A native socket always owns its standard index, even if it replaced a
        # bridge link; move the displaced Flatpak provider to another free slot.
        targets = dict(native)
        for slot, path in self.targets.items():
            canonical = self.runtime / f"discord-ipc-{slot}"
            if (path in providers and slot not in targets
                    and (not os.path.lexists(canonical) or owns_link(canonical, slot))):
                targets[slot] = path
        for path in providers:
            if path in targets.values():
                continue
            preferred = int(path.name.rsplit("-", 1)[1])
            for slot in [preferred, *(index for index in SLOTS if index != preferred)]:
                canonical = self.runtime / f"discord-ipc-{slot}"
                if (slot not in targets and (not os.path.lexists(canonical)
                                             or owns_link(canonical, slot))):
                    targets[slot] = path
                    break
        self.targets = targets

        # Producers stop scanning at the first successful connect(). Publish
        # only live slots, so an empty proxy cannot hide a later Discord client.
        # Keep the directory itself stable for existing Flatpak/Steam mounts.
        for slot in self.servers.keys() - targets.keys():
            server = self.servers.pop(slot)
            server.close()
            (self.directory / f"discord-ipc-{slot}").unlink(missing_ok=True)
        for slot in targets.keys() - self.servers.keys():
            path = self.directory / f"discord-ipc-{slot}"
            self.servers[slot] = await asyncio.start_unix_server(
                lambda reader, writer, index=slot: self.accept(index, reader, writer),
                path=str(path))
            path.chmod(0o600)

        # Modern Flatpak binds its private runtime directory into the sandbox.
        # Relative targets resolve through the narrow shared directory there
        # and on the host. Never replace an app's real socket or own link.
        for directory in [self.runtime, *private]:
            for slot in SLOTS:
                path = directory / f"discord-ipc-{slot}"
                if slot in targets:
                    try:
                        path.symlink_to(link_target(slot))
                    except (FileExistsError, FileNotFoundError):
                        pass  # Existing app socket/link, or an exiting Flatpak.
                elif owns_link(path, slot):
                    path.unlink(missing_ok=True)

    def accept(self, slot, reader, writer):
        task = asyncio.create_task(self.relay(slot, reader, writer))
        self.connections.add(task)
        task.add_done_callback(self.connections.discard)

    async def relay(self, slot, reader, writer):
        upstream = None
        pumps = []
        try:
            target = self.targets.get(slot)
            if target is None:
                return
            source, upstream = await asyncio.open_unix_connection(str(target))

            async def copy(incoming, outgoing):
                while data := await incoming.read(65536):
                    outgoing.write(data)
                    await outgoing.drain()
                outgoing.write_eof()

            pumps = [asyncio.create_task(copy(reader, upstream)),
                     asyncio.create_task(copy(source, writer))]
            await asyncio.gather(*pumps)
        except (OSError, RuntimeError):
            pass  # Client exited, or its socket was replaced between scans.
        finally:
            for pump in pumps:
                pump.cancel()
            await asyncio.gather(*pumps, return_exceptions=True)
            for stream in (writer, upstream):
                if stream is not None:
                    stream.close()
                    try:
                        await stream.wait_closed()
                    except OSError:
                        pass

    async def start(self):
        self.directory.mkdir(mode=0o700, exist_ok=True)
        self.lock = (self.directory / ".lock").open("a")
        fcntl.flock(self.lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        for slot in SLOTS:
            path = self.directory / f"discord-ipc-{slot}"
            # The lock proves there is no live instance using these sockets.
            if os.path.lexists(path):
                if not stat.S_ISSOCK(path.lstat().st_mode):
                    raise RuntimeError(f"Unexpected file at {path}")
                path.unlink()
        await self.refresh()

    async def stop(self):
        for server in self.servers.values():
            server.close()
        for task in tuple(self.connections):
            task.cancel()
        await asyncio.gather(*self.connections, return_exceptions=True)
        for slot, server in self.servers.items():
            await server.wait_closed()
            (self.directory / f"discord-ipc-{slot}").unlink(missing_ok=True)
        self.servers.clear()
        if self.lock is not None:
            self.lock.close()

    async def run(self):
        done = asyncio.Event()
        loop = asyncio.get_running_loop()
        for sig in (signal.SIGINT, signal.SIGTERM):
            loop.add_signal_handler(sig, done.set)
        try:
            await self.start()
            while not done.is_set():
                await self.refresh()
                try:
                    await asyncio.wait_for(done.wait(), timeout=0.5)
                except TimeoutError:
                    pass
        finally:
            await self.stop()


if __name__ == "__main__":
    os.umask(0o077)
    asyncio.run(Bridge(os.environ["XDG_RUNTIME_DIR"]).run())
