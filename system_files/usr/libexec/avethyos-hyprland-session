#!/bin/bash
set -euo pipefail

export XDG_CURRENT_DESKTOP=Hyprland XDG_SESSION_DESKTOP=Hyprland XDG_SESSION_TYPE=wayland
session_vars=(WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE XDG_DATA_DIRS)
systemctl --user import-environment "${session_vars[@]}"
dbus-update-activation-environment --systemd "${session_vars[@]}"
systemctl --user start hyprland-session.target
systemctl --user restart xdg-desktop-portal-hyprland.service
exec bash "$HOME/.config/quickshell/scripts/run.sh"
